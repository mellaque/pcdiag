root = true

[*]
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# Windows PowerShell 5.1 без BOM читает файл как ANSI и портит кириллицу.
[*.{ps1,psm1,psd1}]
charset = utf-8-bom
end_of_line = crlf

# cmd.exe принимает BOM за часть первой команды: только ASCII.
[*.cmd]
charset = latin1
end_of_line = crlf

[*.{md,yml,yaml,json}]
charset = utf-8
end_of_line = lf
indent_size = 2
